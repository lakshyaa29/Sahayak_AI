# SAHAYAK AI - Backend Configuration
APP_NAME=SAHAYAK AI API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL with PostGIS)
# Default points to standard docker-compose service
DATABASE_URL=postgresql://sahayak_user:sahayak_password@localhost:5432/sahayak_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Logging
LOG_LEVEL=INFO
